{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovo.proof-checks/1",
  "type": "object",
  "required": ["schema", "contract_id", "checks"],
  "properties": {
    "schema": {"const": "ovo.proof-checks/1"},
    "contract_id": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "level", "status", "claim", "checker", "evidence_refs", "scope", "reason"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "level": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
          "status": {"enum": ["PASS", "FAIL", "UNCHECKED", "INDETERMINATE", "EXPIRED"]},
          "claim": {"type": "string", "minLength": 1},
          "checker": {
            "type": "object",
            "required": ["name", "version", "independence"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "independence": {"enum": ["executor_observed", "independent_state", "independent_validator", "external_observation"]}
            }
          },
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "scope": {"type": "string", "minLength": 1},
          "reason": {"type": "string"},
          "valid_until": {"type": ["string", "null"]}
        }
      }
    }
  }
}
