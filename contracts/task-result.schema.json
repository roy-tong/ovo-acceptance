{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "ovo.task-result/1",
  "title": "OVO business task result",
  "description": "A read-only projection of an existing product task state. It exposes business progress, evidence, scoped blockers, actionable next steps and a resume reference without implying background execution, external delivery or business acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "task_id", "product", "status", "completed", "observations",
    "evidence_refs", "missing_conditions", "next_actions",
    "user_decision_required", "resume_ref"
  ],
  "properties": {
    "schema": {"const": "ovo.task-result/1"},
    "task_id": {"type": "string", "minLength": 1},
    "product": {"type": "string", "enum": ["askovo", "growovo", "verovo", "family"]},
    "status": {
      "type": "string",
      "enum": [
        "running", "waiting_external", "needs_decision", "partial_result",
        "completed", "unable_to_complete"
      ]
    },
    "completed": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "observations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "missing_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail", "blocking"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description", "requires_user"],
        "properties": {
          "kind": {"type": "string", "enum": ["capability", "command", "instruction"]},
          "description": {"type": "string", "minLength": 1},
          "requires_user": {"type": "boolean"},
          "capability": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1}
        }
      }
    },
    "user_decision_required": {"type": "boolean"},
    "resume_ref": {"type": "string", "minLength": 1}
  }
}
