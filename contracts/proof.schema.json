{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovo.proof/1",
  "type": "object",
  "required": ["schema", "proof_id", "contract_id", "product", "generated_at", "environment", "artifacts", "replay", "limitations"],
  "properties": {
    "schema": {"const": "ovo.proof/1"},
    "proof_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "environment": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "sha256", "classification"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "classification": {"enum": ["synthetic", "public-redacted", "private"]}
        }
      }
    },
    "replay": {
      "type": "object",
      "required": ["manifest", "status", "missing"],
      "properties": {
        "manifest": {"type": "string", "minLength": 1},
        "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
        "missing": {"type": "array"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
